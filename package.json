{
  "name": "@kibocommerce/onx-fulfillment-adapter",
  "version": "1.0.1",
  "description": "Commerce Operations Foundation adapter for Kibo Commerce",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:integration": "npm run build && node test-integration.js",
    "lint": "eslint .",
    "server": "npm run build && node -r dotenv/config dist/server.js",
    "dev:server": "tsc && node --inspect -r dotenv/config dist/server.js",
    "prepublishOnly": "npm run build && npm test",
    "dev": "tsc --watch"
  },
  "keywords": [
    "cof",
    "onx",
    "fulfillment",
    "adapter",
    "mcp",
    "kibo",
    "kibocommerce"
  ],
  "author": "Kibo Commerce",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.8.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.7.0"
  },
  "dependencies": {
    "@cof-org/mcp": "^0.5.1",
    "@kibocommerce/rest-sdk": "^2.2530.1",
    "axios": "^1.6.0",
    "express": "^5.2.1"
  }
}
